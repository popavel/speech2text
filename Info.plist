<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- Explicit because this is a manual INFOPLIST_FILE, which xcodebuild does not auto-populate.
	     Why: docs/build.md#infoplist-keys -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleDisplayName</key>
	<string>Speech2Text</string>
	<key>CFBundleName</key>
	<string>Speech2Text</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<!-- Sparkle's feed, via GitHub's stable latest-release-asset redirect.
	     NEVER change this URL — it is baked into every shipped binary, so changing it strands
	     every copy installed before the change.
	     Why: docs/distribution.md#sufeedurl-is-permanent -->
	<key>SUFeedURL</key>
	<string>https://github.com/popavel/speech2text/releases/latest/download/appcast.xml</string>
	<!-- Public half of the Sparkle EdDSA keypair; updates are rejected unless signed by the
	     matching private key.
	     Why: docs/distribution.md#secrets -->
	<key>SUPublicEDKey</key>
	<string>/R4d1Sr+880QpYA/a5/P9OjM7MY6QiYq91qruQjeHJs=</string>
	<!-- Auto-check ~daily without Sparkle's second-launch prompt; the Settings toggle opts out. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
